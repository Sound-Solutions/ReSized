<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ReSized</title>
    <organization>com.SoundSolutionsLLC</organization>
    <welcome file="welcome.html"/>
    <license file="license.html"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="app"/>
    </choices-outline>
    <choice id="app" title="ReSized" description="Install ReSized to /Applications" visible="false">
        <pkg-ref id="com.resized.ReSized"/>
    </choice>
    <pkg-ref id="com.resized.ReSized" version="1.1">ReSized-component.pkg</pkg-ref>
</installer-gui-script>
